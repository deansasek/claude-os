<?xml version="1.0" encoding="utf-8"?>
<!-- the spark gently grows and turns into place, then holds (the splash screen plays it once) -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_spark">
  <target android:name="spark">
    <aapt:attr name="android:animation">
      <set android:ordering="together">
        <objectAnimator android:propertyName="scaleX" android:duration="800" android:valueFrom="0.4" android:valueTo="0.6" android:valueType="floatType" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <objectAnimator android:propertyName="scaleY" android:duration="800" android:valueFrom="0.4" android:valueTo="0.6" android:valueType="floatType" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <objectAnimator android:propertyName="rotation" android:duration="800" android:valueFrom="-60" android:valueTo="0" android:valueType="floatType" android:interpolator="@android:interpolator/fast_out_slow_in" />
      </set>
    </aapt:attr>
  </target>
  <target android:name="shape">
    <aapt:attr name="android:animation">
      <objectAnimator android:propertyName="fillAlpha" android:duration="500" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" />
    </aapt:attr>
  </target>
</animated-vector>
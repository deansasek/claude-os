{
  "name": "claude-os",
  "version": "1.0.0",
  "description": "ClaudeOS: a home tablet UI and hub for Claude sessions",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "tsc -p . && npm run check:web && npm run check:icons && npm run check:mocks",
    "check:web": "node --disable-warning=ExperimentalWarning scripts/check-web-imports.ts",
    "check:tests": "node --disable-warning=ExperimentalWarning scripts/check-test-list.ts",
    "check:icons": "node --disable-warning=ExperimentalWarning scripts/check-icons.ts",
    "build:page": "node --disable-warning=ExperimentalWarning scripts/build-page.ts",
    "setup": "node --disable-warning=ExperimentalWarning scripts/setup.ts",
    "pc-link": "node --disable-warning=ExperimentalWarning scripts/claude-os-pc-hook.ts install",
    "host": "node host/host.ts",
    "host:stop": "node host/host.ts stop",
    "host:status": "node host/host.ts status",
    "host:logs": "node host/host.ts logs",
    "start": "node --disable-warning=ExperimentalWarning src/main.server.ts",
    "dev": "node --watch src/main.server.ts",
    "test": "node --test --disable-warning=ExperimentalWarning \"test/*.test.ts\"",
    "check:mocks": "node --disable-warning=ExperimentalWarning scripts/check-mocks.ts"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/yauzl": "^3.4.0",
    "typescript": "^7.0.2",
    "yauzl": "^3.4.0"
  },
  "private": "true",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.330"
  }
}
